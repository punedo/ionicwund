<app-admin-shell [pageTitle]="pageTitle">
  @if (activeTab === 'facilities') {
    <p class="tab-description">
      Wohn- und Versorgungseinrichtungen, in denen Patient*innen untergebracht sind – z. B. ein Pflegeheim oder eine Klinik. Der behandelnde Pflegedienst bzw. Homecare-Anbieter wird direkt an der jeweiligen Patientenakte hinterlegt, nicht hier.
    </p>
  }

  <app-data-table
    [title]="tableTitle"
    [columns]="tableColumns"
    [data]="tableData"
    [headerActions]="tableHeaderActions"
    [rowActions]="tableRowActions"
    [tabs]="tabs"
    [activeTab]="activeTab"
    [filters]="tableFilters"
    [searchPlaceholder]="tableSearchPlaceholder"
    [emptyMessage]="tableEmptyMessage"
    [loading]="loading"
    (tabChange)="onTabChange($event)"
    (filterChange)="onFilterChange($event)"
    (searchChange)="onSearch($event)"
  ></app-data-table>

  @if (activeTab === 'facilities') {
    <p class="tab-footer">
      Die früheren Versorgungseinrichtungen-/Homecare-/Arztpraxis-Einträge wurden entfernt. Pflegedienste & Homecare-Anbieter sind ihre eigenen Organisationen (siehe Nutzerverwaltung). Ärzt*innen und Kliniken finden Sie im Tab 'Ärzte'.
    </p>
  }
</app-admin-shell>
