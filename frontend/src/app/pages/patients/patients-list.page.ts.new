import { Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { Router } from '@angular/router';
import { AdminShellComponent } from '../../components/admin-shell/admin-shell.component';
import {
  DataTableComponent,
  TableColumn,
  TableFilter,
  TableHeaderAction,
  TableRowAction,
  TableTab,
} from '../../components/data-table/data-table.component';
import { Patient } from '../../models/patient.model';
import { Facility } from '../../models/facility.model';
import { PatientService } from '../../services/patient.service';
import { FacilityService } from '../../services/facility.service';

@Component({
  selector: 'app-patients-list',
  standalone: true,
  imports: [CommonModule, AdminShellComponent, DataTableComponent],
  templateUrl: './patients-list.page.html',
  styleUrls: ['./patients-list.page.scss'],
})
export class PatientsListPage implements OnInit {
  patients: Patient[] = [];
  filteredPatients: Patient[] = [];
  facilities: Facility[] = [];
  filteredFacilities: Facility[] = [];
  loading = false;

  activeTab = 'patients';
  searchQuery = '';

  tabs: TableTab[] = [
    { id: 'patients', label: 'Patienten' },
    { id: 'facilities', label: 'Einrichtungen' },
    { id: 'doctors', label: 'Ärzte' },
  ];

  patientFilters: TableFilter[] = [
    {
      key: 'status',
      label: 'Status',
      value: 'all',
      options: [
        { value: 'all', label: 'Status: Alle' },
        { value: 'neu', label: 'neu' },
        { value: 'Beobachtung', label: 'Beobachtung' },
        { value: 'kritisch', label: 'kritisch' },
      ],
    },
    {
      key: 'woundType',
      label: 'Wundtyp',
      value: 'all',
      options: [
        { value: 'all', label: 'Wundtyp: Alle' },
        { value: 'Diabetisches Fußsyndrom', label: 'Diabetisches Fußsyndrom' },
        { value: 'Ulcus cruris varicosum', label: 'Ulcus cruris varicosum' },
        { value: 'Dekubital-Sakral', label: 'Dekubital-Sakral' },
        { value: 'Dekubital-Trochanter', label: 'Dekubital-Trochanter' },
        { value: 'Postoperativ', label: 'Postoperativ' },
      ],
    },
  ];

  facilityFilters: TableFilter[] = [
    {
      key: 'type',
      label: 'Typ',
      value: 'all',
      options: [
        { value: 'all', label: 'Typ: Alle' },
        { value: 'Pflegeheim (stationär)', label: 'Pflegeheim (stationär)' },
        { value: 'Betreutes Wohnen', label: 'Betreutes Wohnen' },
        { value: 'Klinik / Krankenhaus', label: 'Klinik / Krankenhaus' },
      ],
    },
  ];

  doctorFilters: TableFilter[] = [];

  patientColumns: TableColumn<Patient>[] = [
    {
      key: 'lastName',
      label: 'Patient',
      sortable: true,
      width: '180px',
      format: (p) => `${p.lastName}, ${p.firstName} (*${this.extractYear(p.dateOfBirth)})`,
    },
    { key: 'woundType', label: 'Wundtyp', sortable: true },
    { key: 'score', label: 'Score / Status', sortable: true },
    {
      key: 'responsible',
      label: 'Zuständig',
      type: 'multiline',
      sortable: true,
      format: (p) => p.responsible ?? [],
    },
    { key: 'lastDocumentedAt', label: 'Letzte Dok.', sortable: true },
    {
      key: 'status',
      label: 'Status',
      type: 'badge',
      sortable: true,
      cssClass: (p) => `status-${(p.status ?? '').toLowerCase()}`,
    },
  ];

  facilityColumns: TableColumn<Facility>[] = [
    { key: 'name', label: 'Einrichtung', sortable: true, width: '220px' },
    { key: 'type', label: 'Typ', sortable: true },
    { key: 'city', label: 'Ort', sortable: true },
    { key: 'patientCount', label: 'Patienten', sortable: true, format: (f) => String(f.patientCount ?? 0) },
    {
      key: 'careServices',
      label: 'Zuständige Pflegedienste',
      type: 'multiline',
      sortable: true,
      format: (f) => f.careServices ?? [],
    },
    {
      key: 'status',
      label: 'Status',
      type: 'badge',
      sortable: true,
      cssClass: (f) => 'status-' + (f.status ?? '').toLowerCase().replace(/\s+/g, '-'),
    },
  ];

  doctorColumns: TableColumn<any>[] = [
    { key: 'name', label: 'Arzt / Klinik', sortable: true },
    { key: 'type', label: 'Fachgebiet', sortable: true },
    { key: 'city', label: 'Ort', sortable: true },
  ];

  patientHeaderActions: TableHeaderAction[] = [
    { label: 'Exportieren', icon: 'download-outline', cssClass: 'secondary' },
    {
      label: 'Patient anlegen',
      icon: 'add-outline',
      cssClass: 'primary',
      onClick: () => this.router.navigate(['/patients/create']),
    },
  ];

  facilityHeaderActions: TableHeaderAction[] = [
    { label: 'Exportieren', icon: 'download-outline', cssClass: 'secondary' },
    {
      label: 'Einrichtung anlegen',
      icon: 'add-outline',
      cssClass: 'primary',
      onClick: () => console.log('Einrichtung anlegen'),
    },
  ];

  doctorHeaderActions: TableHeaderAction[] = [];

  patientRowActions: TableRowAction<Patient>[] = [
    {
      label: 'Summed',
      icon: 'list-outline',
      onClick: (patient) => this.onSummary(patient),
    },
    {
      label: 'Versorgung',
      icon: 'bandage-outline',
      onClick: (patient) => this.onCare(patient),
    },
    {
      label: 'Dokumente',
      icon: 'document-text-outline',
      onClick: (patient) => this.onDocuments(patient),
    },
  ];

  facilityRowActions: TableRowAction<Facility>[] = [
    {
      label: 'Bearbeiten',
      icon: 'create-outline',
      onClick: (facility) => console.log('Bearbeiten', facility),
    },
    {
      label: 'Löschen',
      icon: 'trash-outline',
      cssClass: 'danger',
      onClick: (facility) => this.onDeleteFacility(facility),
    },
  ];

  doctorRowActions: TableRowAction<any>[] = [];

  constructor(
    private patientService: PatientService,
    private facilityService: FacilityService,
    private router: Router
  ) {}

  get pageTitle(): string {
    return this.tableTitle;
  }

  get tableTitle(): string {
    switch (this.activeTab) {
      case 'facilities':
        return 'Einrichtungen';
      case 'doctors':
        return 'Ärzte';
      default:
        return 'Patienten';
    }
  }

  get tableData(): any[] {
    switch (this.activeTab) {
      case 'facilities':
        return this.filteredFacilities;
      case 'doctors':
        return [];
      default:
        return this.filteredPatients;
    }
  }

  get tableColumns(): TableColumn<any>[] {
    switch (this.activeTab) {
      case 'facilities':
        return this.facilityColumns;
      case 'doctors':
        return this.doctorColumns;
      default:
        return this.patientColumns;
    }
  }

  get tableFilters(): TableFilter[] {
    switch (this.activeTab) {
      case 'facilities':
        return this.facilityFilters;
      case 'doctors':
        return this.doctorFilters;
      default:
        return this.patientFilters;
    }
  }

  get tableHeaderActions(): TableHeaderAction[] {
    switch (this.activeTab) {
      case 'facilities':
        return this.facilityHeaderActions;
      case 'doctors':
        return this.doctorHeaderActions;
      default:
        return this.patientHeaderActions;
    }
  }

  get tableRowActions(): TableRowAction<any>[] {
    switch (this.activeTab) {
      case 'facilities':
        return this.facilityRowActions;
      case 'doctors':
        return this.doctorRowActions;
      default:
        return this.patientRowActions;
    }
  }

  get tableSearchPlaceholder(): string {
    if (this.activeTab === 'facilities') {
      return 'Suche nach Name, Ort ...';
    }
    if (this.activeTab === 'doctors') {
      return 'Suche nach Name, Fachgebiet ...';
    }
    return 'Suche nach Name, ID, Wund...';
  }

  get tableEmptyMessage(): string {
    switch (this.activeTab) {
      case 'facilities':
        return 'Keine Einrichtungen gefunden.';
      case 'doctors':
        return 'Keine Ärzte gefunden.';
      default:
        return 'Keine Patienten gefunden.';
    }
  }

  ngOnInit(): void {
    this.loadData();
  }

  loadData(): void {
    this.loading = true;

    if (this.activeTab === 'patients') {
      this.loadPatients();
    } else if (this.activeTab === 'facilities') {
      this.loadFacilities();
    } else {
      this.loading = false;
      this.filteredPatients = [];
      this.filteredFacilities = [];
    }
  }

  loadPatients(): void {
    this.patientService.getPatients().subscribe({
      next: (data) => {
        console.log('[PatientsListPage] loaded patients:', data);
        this.patients = data;
        this.applyFilters();
        this.loading = false;
      },
      error: (err) => {
        console.error('[PatientsListPage] loadPatients error:', err);
        this.loading = false;
      },
    });
  }

  loadFacilities(): void {
    this.facilityService.getFacilities().subscribe({
      next: (data) => {
        console.log('[PatientsListPage] loaded facilities:', data);
        this.facilities = data;
        this.applyFilters();
        this.loading = false;
      },
      error: (err) => {
        console.error('[PatientsListPage] loadFacilities error:', err);
        this.loading = false;
      },
    });
  }

  onTabChange(tabId: string): void {
    this.activeTab = tabId;
    this.searchQuery = '';
    this.applyFilters();
    this.loadData();
  }

  onFilterChange(event: { key: string; value: string }): void {
    const filters = this.tableFilters;
    const filter = filters.find((f) => f.key === event.key);
    if (filter) {
      filter.value = event.value;
    }
    this.applyFilters();
  }

  onSearch(query: string): void {
    this.searchQuery = query;
    this.applyFilters();
  }

  applyFilters(): void {
    const query = this.searchQuery.trim().toLowerCase();

    if (this.activeTab === 'patients') {
      const statusFilter = this.patientFilters.find((f) => f.key === 'status')?.value ?? 'all';
      const woundTypeFilter = this.patientFilters.find((f) => f.key === 'woundType')?.value ?? 'all';

      this.filteredPatients = this.patients.filter((p) => {
        const matchesStatus = statusFilter === 'all' || p.status === statusFilter;
        const matchesWoundType = woundTypeFilter === 'all' || p.woundType === woundTypeFilter;

        const matchesSearch =
          !query ||
          `${p.lastName}, ${p.firstName}`.toLowerCase().includes(query) ||
          (p.woundType?.toLowerCase() ?? '').includes(query) ||
          (p.status?.toLowerCase() ?? '').includes(query) ||
          (p.responsible?.some((r) => r.toLowerCase().includes(query)) ?? false);

        return matchesStatus && matchesWoundType && matchesSearch;
      });
      return;
    }

    if (this.activeTab === 'facilities') {
      const typeFilter = this.facilityFilters.find((f) => f.key === 'type')?.value ?? 'all';

      this.filteredFacilities = this.facilities.filter((f) => {
        const matchesType = typeFilter === 'all' || f.type === typeFilter;

        const matchesSearch =
          !query ||
          (f.name?.toLowerCase() ?? '').includes(query) ||
          (f.type?.toLowerCase() ?? '').includes(query) ||
          (f.city?.toLowerCase() ?? '').includes(query) ||
          (f.careServices?.some((s) => s.toLowerCase().includes(query)) ?? false);

        return matchesType && matchesSearch;
      });
      return;
    }

    this.filteredPatients = [];
    this.filteredFacilities = [];
  }

  onSummary(patient: Patient): void {
    // TODO: navigate to summary/detail view
    console.log('Summary for', patient);
  }

  onCare(patient: Patient): void {
    // TODO: navigate to care planning
    console.log('Care for', patient);
  }

  onDocuments(patient: Patient): void {
    // TODO: navigate to documents
    console.log('Documents for', patient);
  }

  onDeleteFacility(facility: Facility): void {
    if (!confirm(`Einrichtung "${facility.name}" wirklich löschen?`)) {
      return;
    }

    this.facilityService.deleteFacility(facility.id).subscribe({
      next: () => this.loadFacilities(),
      error: (err) => console.error('[PatientsListPage] deleteFacility error:', err),
    });
  }

  private extractYear(date?: string): string {
    if (!date) {
      return '—';
    }
    const parsed = new Date(date);
    if (isNaN(parsed.getTime())) {
      return date;
    }
    return String(parsed.getFullYear());
  }
}
